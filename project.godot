; Engine configuration file.
config_version=5

[application]

config/name="blockbox"
; 배포 워크플로가 빌드마다 날짜와 커밋 해시로 덮어쓴다. 시작 화면에 그대로
; 표시되므로, 폰에서 지금 어떤 빌드를 보고 있는지 바로 알 수 있다.
config/version="dev"
run/main_scene="res://scenes/start.tscn"
; 웹 빌드의 파비콘과 iOS "홈 화면에 추가" 아이콘이 이 파일에서 나온다
; (Web 프리셋의 html/export_icon).
config/icon="res://assets/icon.png"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="forward_plus"

[gui]

; 웹에는 시스템 폰트가 없고 Godot 내장 폰트에는 한글 글리프가 없다.
; 폰트를 지정하지 않으면 아이폰 사파리에서 한글이 전부 깨진다.
;
; 글꼴, 글자 크기, 버튼 모양을 전부 이 테마 하나에 둔다. 여기 있던
; theme/default_font_size 는 실제로 먹지 않아서 (ThemeDB.fallback_font_size 가
; 16 그대로였다) 폰에서 모든 글씨가 16pt 로 나왔다.
theme/custom="res://assets/ui/theme.tres"

[input_devices]

; 데스크톱에는 InputEventScreenDrag 가 없다. 이게 없으면 스와이프 조작 전체가
; 에디터/맥에서 죽은 코드가 된다.
pointing/emulate_touch_from_mouse=true
